{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qasr-cli/models-path.json",
  "title": "qasr models path",
  "type": "object",
  "required": ["schema_version", "ok", "command", "action", "path"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"const": true},
    "command": {"const": "models"},
    "action": {"const": "path"},
    "alias": {"type": ["string", "null"]},
    "repo": {"type": ["string", "null"]},
    "kind": {"type": "string"},
    "path": {"type": "string"},
    "source": {"type": "string"}
  },
  "additionalProperties": true
}
