{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qasr-cli/error.json",
  "title": "qasr error envelope",
  "type": "object",
  "required": ["schema_version", "ok", "command", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"const": false},
    "command": {"type": "string"},
    "error": {"$ref": "#/$defs/error"}
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["kind", "code", "message", "retryable", "details"],
      "properties": {
        "kind": {
          "enum": ["usage", "config", "input", "capability", "model", "runtime", "quality", "partial", "internal"]
        },
        "code": {"type": "integer", "enum": [2, 3, 4, 5, 6, 130]},
        "message": {"type": "string"},
        "hint": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
